# Supabase project URL (Project Settings -> API)
SUPABASE_URL=your_supabase_project_url

# Supabase SERVICE ROLE key (Project Settings -> API). This key bypasses
# Row-Level Security — keep it server-side only, never expose it to the
# frontend or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
