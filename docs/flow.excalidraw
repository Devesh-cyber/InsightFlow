    {
      "id": "RGu9EvN4-a-yH02qBsp-J",
      "type": "text",
      "x": 7119.976098923455,
      "y": -792.1904761904766,
      "width": 1342.1575927734375,
      "height": 2275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b68",
      "roundness": null,
      "seed": 1299430944,
      "version": 34,
      "versionNonce": 716807712,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785649524464,
      "link": null,
      "locked": false,
      "text": "backend/\n│\n├── app/                               # Main backend application\n│\n│   ├── main.py                        # Starts FastAPI, registers routers, middleware\n│   │\n│   ├── api/                           # Receives HTTP requests (Routers)\n│   │   ├── upload.py                  # Upload dataset endpoints\n│   │   ├── overview.py                # Dataset overview endpoints\n│   │   ├── health.py                  # Dataset health endpoints\n│   │   ├── columns.py                 # Individual column analysis endpoints\n│   │   ├── relationships.py           # Feature relationship endpoints\n│   │   ├── visualization.py           # Chart generation endpoints\n│   │   ├── cleaning.py                # Data cleaning endpoints\n│   │   └── export.py                  # Export dataset/report endpoints\n│   │\n│   ├── services/                      # Business logic (What the application does)\n│   │   ├── upload_service.py          # Handles upload workflow\n│   │   ├── processing_service.py      # Runs the data processing pipeline\n│   │   ├── overview_service.py        # Generates overview statistics\n│   │   ├── health_service.py          # Computes health score & issues\n│   │   ├── column_service.py          # Computes per-column analysis\n│   │   ├── relationship_service.py    # Computes correlations & relationships\n│   │   ├── visualization_service.py   # Prepares data for charts\n│   │   ├── cleaning_service.py        # Applies cleaning operations\n│   │   └── export_service.py          # Generates downloadable files\n│   │\n│   ├── processors/                    # Core data engine (Reusable processing)\n│   │   ├── validator.py               # Validates uploaded datasets\n│   │   ├── loader.py                  # Reads CSV/XLSX into Pandas\n│   │   ├── normalizer.py              # Standardizes missing values & formats\n│   │   ├── metadata.py                # Generates reusable dataset metadata\n│   │   ├── type_detector.py           # Detects semantic column types\n│   │   └── session_manager.py         # Stores & manages active datasets\n│   │\n│   ├── models/                        # Pydantic request/response models\n│   │   ├── upload.py                  # Upload schemas\n│   │   ├── dataset.py                 # Dataset & metadata models\n│   │   ├── overview.py                # Overview response models\n│   │   ├── health.py                  # Health response models\n│   │   ├── column.py                  # Column analysis models\n│   │   ├── visualization.py           # Chart request/response models\n│   │   ├── cleaning.py                # Cleaning request models\n│   │   └── export.py                  # Export response models\n│   │\n│   ├── utils/                         # Common helper functions\n│   │   ├── file_utils.py              # File handling helpers\n│   │   ├── pandas_utils.py            # Common Pandas operations\n│   │   ├── statistics.py              # Shared statistical functions\n│   │   ├── plotting.py                # Chart helper functions\n│   │   └── constants.py               # Project-wide constants\n│   │\n│   ├── config/\n│   │   └── settings.py                # Configuration (limits, paths, API keys)\n│   │\n│   └── core/\n│       └── exceptions.py              # Custom exception classes\n│\n├── datasets/                          # Temporary uploaded datasets\n│\n├── tests/                             # Unit & API tests\n│\n├── requirements.txt                   # Python dependencies\n│\n└── README.md                          # Backend documentation",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "backend/\n│\n├── app/                               # Main backend application\n│\n│   ├── main.py                        # Starts FastAPI, registers routers, middleware\n│   │\n│   ├── api/                           # Receives HTTP requests (Routers)\n│   │   ├── upload.py                  # Upload dataset endpoints\n│   │   ├── overview.py                # Dataset overview endpoints\n│   │   ├── health.py                  # Dataset health endpoints\n│   │   ├── columns.py                 # Individual column analysis endpoints\n│   │   ├── relationships.py           # Feature relationship endpoints\n│   │   ├── visualization.py           # Chart generation endpoints\n│   │   ├── cleaning.py                # Data cleaning endpoints\n│   │   └── export.py                  # Export dataset/report endpoints\n│   │\n│   ├── services/                      # Business logic (What the application does)\n│   │   ├── upload_service.py          # Handles upload workflow\n│   │   ├── processing_service.py      # Runs the data processing pipeline\n│   │   ├── overview_service.py        # Generates overview statistics\n│   │   ├── health_service.py          # Computes health score & issues\n│   │   ├── column_service.py          # Computes per-column analysis\n│   │   ├── relationship_service.py    # Computes correlations & relationships\n│   │   ├── visualization_service.py   # Prepares data for charts\n│   │   ├── cleaning_service.py        # Applies cleaning operations\n│   │   └── export_service.py          # Generates downloadable files\n│   │\n│   ├── processors/                    # Core data engine (Reusable processing)\n│   │   ├── validator.py               # Validates uploaded datasets\n│   │   ├── loader.py                  # Reads CSV/XLSX into Pandas\n│   │   ├── normalizer.py              # Standardizes missing values & formats\n│   │   ├── metadata.py                # Generates reusable dataset metadata\n│   │   ├── type_detector.py           # Detects semantic column types\n│   │   └── session_manager.py         # Stores & manages active datasets\n│   │\n│   ├── models/                        # Pydantic request/response models\n│   │   ├── upload.py                  # Upload schemas\n│   │   ├── dataset.py                 # Dataset & metadata models\n│   │   ├── overview.py                # Overview response models\n│   │   ├── health.py                  # Health response models\n│   │   ├── column.py                  # Column analysis models\n│   │   ├── visualization.py           # Chart request/response models\n│   │   ├── cleaning.py                # Cleaning request models\n│   │   └── export.py                  # Export response models\n│   │\n│   ├── utils/                         # Common helper functions\n│   │   ├── file_utils.py              # File handling helpers\n│   │   ├── pandas_utils.py            # Common Pandas operations\n│   │   ├── statistics.py              # Shared statistical functions\n│   │   ├── plotting.py                # Chart helper functions\n│   │   └── constants.py               # Project-wide constants\n│   │\n│   ├── config/\n│   │   └── settings.py                # Configuration (limits, paths, API keys)\n│   │\n│   └── core/\n│       └── exceptions.py              # Custom exception classes\n│\n├── datasets/                          # Temporary uploaded datasets\n│\n├── tests/                             # Unit & API tests\n│\n├── requirements.txt                   # Python dependencies\n│\n└── README.md                          # Backend documentation",
      "autoResize": true,
      "lineHeight": 1.25
    }
